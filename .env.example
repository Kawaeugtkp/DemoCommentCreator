# ============================================
# ログイン用の固定文字列
# ============================================
LOGIN_TEXT=changeme-login-secret

# ============================================
# Firebase Auth（Identity Toolkit REST）
#   サーバー側で signInWithPassword を叩くために使用。
#   FIREBASE_API_KEY は Firebase コンソール > プロジェクトの設定 > ウェブ API キー。
# ============================================
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# ============================================
# 20アカウント共通パスワード（共通なので1つだけ）
# ============================================
ACCOUNT_PASSWORD=common-password-for-all-20-accounts

# ============================================
# 20アカウントのメールアドレス
# ============================================
ACCOUNT_EMAIL_1=account1@example.com
ACCOUNT_EMAIL_2=account2@example.com
ACCOUNT_EMAIL_3=account3@example.com
ACCOUNT_EMAIL_4=account4@example.com
ACCOUNT_EMAIL_5=account5@example.com
ACCOUNT_EMAIL_6=account6@example.com
ACCOUNT_EMAIL_7=account7@example.com
ACCOUNT_EMAIL_8=account8@example.com
ACCOUNT_EMAIL_9=account9@example.com
ACCOUNT_EMAIL_10=account10@example.com
ACCOUNT_EMAIL_11=account11@example.com
ACCOUNT_EMAIL_12=account12@example.com
ACCOUNT_EMAIL_13=account13@example.com
ACCOUNT_EMAIL_14=account14@example.com
ACCOUNT_EMAIL_15=account15@example.com
ACCOUNT_EMAIL_16=account16@example.com
ACCOUNT_EMAIL_17=account17@example.com
ACCOUNT_EMAIL_18=account18@example.com
ACCOUNT_EMAIL_19=account19@example.com
